        <node name="color_graphic" position="1.00,3.00" prototype="corevector.colorize">
            <port name="fill" type="color" value="#6366f1ee"/>
            <port name="stroke" type="color" value="#818cf8ff"/>
            <port name="strokeWidth" type="float" value="2.0"/>
