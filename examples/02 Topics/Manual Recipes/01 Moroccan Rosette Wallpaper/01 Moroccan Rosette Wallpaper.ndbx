        <node name="color_title" position="5.00,5.00" prototype="corevector.colorize">
            <port name="fill" type="color" value="#f43f5eff"/>
        </node>
        <node name="combine_all" position="3.00,9.00" prototype="list.combine"/>
        <conn input="rosette.shape" output="base_petal"/>
        <conn input="tiled_pattern.shape" output="rosette"/>
        <conn input="color_pattern.shape" output="tiled_pattern"/>
        <conn input="color_title.shape" output="title"/>
        <conn input="combine_all.list1" output="color_pattern"/>
        <conn input="combine_all.list2" output="color_title"/>
    </node>
