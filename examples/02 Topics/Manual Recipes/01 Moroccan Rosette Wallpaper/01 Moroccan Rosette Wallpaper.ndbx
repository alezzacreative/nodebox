<ndbx formatVersion="22" type="file" uuid="a1111111-2222-3333-4444-555555555501">
    <property name="canvasHeight" value="800"/>
    <property name="canvasWidth" value="800"/>
    <node name="root" prototype="core.network" renderedChild="combine_all">
        <node name="base_petal" position="1.00,1.00" prototype="corevector.ellipse">
            <port name="position" type="point" value="40.00,0.00"/>
            <port name="width" type="float" value="80.0"/>
            <port name="height" type="float" value="28.0"/>
        </node>
        <node name="rosette" position="1.00,3.00" prototype="corevector.kaleidoscope">
            <port name="segments" type="int" value="12"/>
            <port name="mirror" type="boolean" value="true"/>
        </node>
        <node name="tiled_pattern" position="1.00,5.00" prototype="corevector.seamless_tile">
            <port name="width" type="float" value="300.0"/>
            <port name="height" type="float" value="300.0"/>
            <port name="clip" type="boolean" value="false"/>
        </node>
        <node name="color_pattern" position="1.00,7.00" prototype="corevector.colorize">
            <port name="fill" type="color" value="#8b5cf6cc"/>
            <port name="stroke" type="color" value="#f43f5eff"/>
            <port name="strokeWidth" type="float" value="1.5"/>
        </node>
        <node name="title" position="5.00,3.00" prototype="corevector.fit_text">
            <port name="text" type="string" value="RECIPE 1: MOROCCAN ROSETTE SEAMLESS WALLPAPER"/>
            <port name="fontName" type="string" value="Helvetica"/>
            <port name="position" type="point" value="0.00,-340.00"/>
            <port name="width" type="float" value="680.0"/>
            <port name="height" type="float" value="28.0"/>
            <port name="alignment" type="string" value="CENTER"/>
