        </node>
        <node name="color_title" position="5.00,5.00" prototype="corevector.colorize">
            <port name="fill" type="color" value="#fbbf24ff"/>
        </node>
        <node name="combine_all" position="3.00,9.00" prototype="list.combine"/>
        <conn input="round_corners.shape" output="star_base"/>
        <conn input="extrude.shape" output="round_corners"/>
        <conn input="color_logo.shape" output="extrude"/>
        <conn input="color_title.shape" output="brand_title"/>
        <conn input="combine_all.list1" output="color_logo"/>
        <conn input="combine_all.list2" output="color_title"/>
