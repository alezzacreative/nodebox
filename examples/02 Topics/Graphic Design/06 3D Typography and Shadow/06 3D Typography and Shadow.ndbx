        <node name="combine_all" position="3.00,7.00" prototype="list.combine"/>
        <conn input="extrude.shape" output="title"/>
        <conn input="shadow.shape" output="extrude"/>
        <conn input="color_subtitle.shape" output="subtitle"/>
        <conn input="combine_all.list1" output="shadow"/>
        <conn input="combine_all.list2" output="color_subtitle"/>
