        <conn input="color_core.shape" output="pointer_core"/>
        <conn input="color_dots.shape" output="dots"/>
        <conn input="color_title.shape" output="title"/>
        <conn input="combine_all.list1" output="color_dots"/>
        <conn input="combine_all.list2" output="color_ring"/>
        <conn input="combine_all.list3" output="color_core"/>
        <conn input="combine_all.list4" output="color_title"/>
    </node>
</ndbx>
