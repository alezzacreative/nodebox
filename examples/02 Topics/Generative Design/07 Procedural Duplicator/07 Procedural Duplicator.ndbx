        <node name="colorize_dupes" position="1.00,5.00" prototype="corevector.colorize">
            <port name="fill" type="color" value="#06b6d4cc"/>
            <port name="stroke" type="color" value="#38bdf8ff"/>
            <port name="strokeWidth" type="float" value="1.0"/>
