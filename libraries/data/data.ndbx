<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ndbx type="file" uuid="16d37cb2-e85b-4e00-a6a2-92340bd2c5b1">
    <link href="java:nodebox.function.DataFunctions" rel="functions"/>
    <node description="Import and manipulate all kinds of data." name="root" renderedChild="lookup">
        <node description="Import a text file and return each line of the file." function="data/importText" image="import_csv.png" name="import_text" outputRange="list" outputType="string" position="1.00,1.00" category="data">
            <port name="file" range="value" type="string" value="" widget="file" description="The text file."/>
        </node>
        <node description="Import a comma-separated value file containing tabular data." function="data/importCSV" image="import_csv.png" name="import_csv" outputRange="list" outputType="data" position="1.00,1.00" category="data">
            <port name="file" range="value" type="string" value="" widget="file" description="The CSV file."/>
            <port name="delimiter" range="value" type="string" value="comma" widget="menu" description="The character used to separate columns.">
                <menu key="comma" label=","/>
                <menu key="semicolon" label=";"/>
                <menu key="colon" label=":"/>
                <menu key="tab" label="Tab"/>
                <menu key="space" label="Space"/>
            </port>
            <port name="quotes" range="value" type="string" value="double" widget="menu" description="The type of quotes used in the file.">
                <menu key="double" label="&quot;"/>
                <menu key="single" label="'"/>
            </port>
            <port name="number_separator" range="value" type="string" value="period" widget="menu" description="The character used to separate the fractional part.">
                <menu key="period" label="."/>
                <menu key="comma" label=","/>
            </port>
        </node>
        <node description="Make a data table out of lists." function="data/makeTable" image="make_table.png" name="make_table" outputRange="list" outputType="data" position="1.00,2.00" category="data">
            <port name="headers" type="string" value="alpha;beta" description="The names of the headers separated by semicolons or commas."/>
            <port name="list1" range="list" type="list" description="The first list."/>
            <port name="list2" range="list" type="list" description="The second list."/>
            <port name="list3" range="list" type="list" description="The third list."/>
            <port name="list4" range="list" type="list" description="The fourth list."/>
            <port name="list5" range="list" type="list" description="The fifth list."/>
            <port name="list6" range="list" type="list" description="The sixth list."/>
        </node>
        <node description="Look up a value in a table or object." function="data/lookup" image="lookup.png" name="lookup" outputType="data" position="1.00,3.00" category="data">
            <port name="list" range="value" type="list" widget="none" description="The input value."/>
            <port name="key" range="value" type="string" value="x" widget="string" description="The key to lookup."/>
        </node>
        <node description="Filter the data based on key/value." function="data/filterData" name="filter_data" outputRange="list" outputType="data" position="2.00,4.00" category="data">
            <port name="data" range="list" type="data" widget="none"/>
            <port name="key" range="value" type="string" value="name" widget="string"/>
            <port name="op" range="value" type="string" value="=" widget="menu">
                <menu key="=" label="= Equal To"/>
                <menu key="!=" label="!= Not Equal To"/>
                <menu key="&gt;" label="&gt; Greater Than"/>
                <menu key="&gt;=" label="&gt;= Greater or Equal Than"/>
                <menu key="&lt;" label="&lt; Smaller Than"/>
                <menu key="&lt;=" label="&lt;= Smaller or Equal Than"/>
            </port>
            <port name="value" range="value" type="string" value="Bob" widget="string"/>
        </node>
        <node description="Sample pixel colors or brightness values from an image at given point coordinates." function="data/sampleImage" image="lookup.png" name="sample_image" outputRange="list" outputType="data" position="2.00,5.00" category="data">
            <port name="file" range="value" type="string" value="" widget="file" description="The image file (PNG, JPG, GIF, BMP)."/>
            <port name="points" range="list" type="list" widget="none" description="Points where the image should be sampled."/>
            <port name="channel" range="value" type="string" value="brightness" widget="menu" description="The channel or value to sample.">
                <menu key="brightness" label="Brightness (0 - 100)"/>
                <menu key="color" label="Color"/>
                <menu key="red" label="Red (0 - 255)"/>
                <menu key="green" label="Green (0 - 255)"/>
                <menu key="blue" label="Blue (0 - 255)"/>
                <menu key="alpha" label="Alpha (0 - 255)"/>
                <menu key="hue" label="Hue (0 - 360)"/>
                <menu key="saturation" label="Saturation (0 - 100)"/>
            </port>
            <port name="origin" range="value" type="string" value="center" widget="menu" description="Coordinate origin mapping.">
                <menu key="center" label="Center (0,0 is center of image)"/>
                <menu key="top_left" label="Top Left (0,0 is top-left corner)"/>
            </port>
        </node>
        <node description="Generate a parametric vector bar chart from numbers." function="data/barchart" image="make_table.png" name="barchart" outputType="geometry" position="2.00,6.00" category="data">
            <port name="values" range="list" type="list" widget="none" description="Numeric data values."/>
            <port name="position" range="value" type="point" value="0.00,0.00" widget="point" description="Chart center position."/>
            <port min="10.0" name="width" range="value" type="float" value="400.0" widget="float" description="Total chart width."/>
            <port min="10.0" name="height" range="value" type="float" value="200.0" widget="float" description="Total chart height."/>
            <port min="0.0" name="bar_padding" range="value" type="float" value="4.0" widget="float" description="Padding between bars."/>
            <port name="orientation" range="value" type="string" value="vertical" widget="menu" description="Bar orientation.">
                <menu key="vertical" label="Vertical"/>
                <menu key="horizontal" label="Horizontal"/>
            </port>
        </node>
        <node description="Generate a parametric vector donut / pie chart from values." function="data/donut" image="make_table.png" name="donut" outputRange="list" outputType="geometry" position="2.00,7.00" category="data">
            <port name="values" range="list" type="list" widget="none" description="Slice proportion values or percentages."/>
            <port name="position" range="value" type="point" value="0.00,0.00" widget="point" description="Donut center position."/>
            <port min="0.0" name="inner_radius" range="value" type="float" value="50.0" widget="float" description="Inner hole radius (0 for solid pie)."/>
            <port min="1.0" name="outer_radius" range="value" type="float" value="120.0" widget="float" description="Outer rim radius."/>
            <port name="start_angle" range="value" type="float" value="0.0" widget="float" description="Starting angle in degrees."/>
        </node>
    </node>
</ndbx>
