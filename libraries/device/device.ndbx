<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ndbx type="file" uuid="a779a96c-efec-4fbd-a804-7c12072bcb74">
    <link href="java:nodebox.function.DeviceFunctions" rel="functions"/>
    <node description="Real time nodes." name="root" prototype="core.network" renderedChild="mouse_position">
        <node category="device" description="Get the most recent mouse position" function="device/mousePosition" image="mouse_position.png" name="mouse_position" outputType="point" position="1.00,2.00">
            <port name="context" range="value" type="context" widget="none"/>
        </node>
        <node category="device" description="Receive messages from OSC" function="device/receiveOSC"
              image="receive_osc.png" name="receive_osc" position="1.00,3.00" outputType="string" outputRange="list">
            <port name="device_name" type="string"
                  description="The osc device to listen to." value="osc1"/>
            <port name="address_prefix" type="string"
                  description="The prefix of the addresses to receive the messages on." value="/"/>
            <port name="arguments" type="string"
                  description="The names of the OSC messages' arguments, delimited by ','"/>
            <port name="context" type="context"
                  description="The internal execution context."/>
        </node>
        <node category="device" description="Send messages over OSC" function="device/sendOSC" image="send_osc.png" name="send_osc" position="1.00,4.00">
            <port name="address" range="value" type="string" value="" widget="string"/>
            <port name="port" range="value" type="int" value="9999" widget="int"/>
            <port name="route" range="value" type="string" value="" widget="string"/>
            <port name="arguments" range="list" type="list" widget="none"/>
        </node>
        <node category="device" description="Audio analysis with Minim" function="device/audioAnalysis"
              image="audio_analysis.png" name="audio_analysis" position="1.00,1.00" outputType="float" outputRange="list">
            <port name="device_name" type="string"
                  description="The audio device." value="audio1"/>
        	<port name="channel" label="Channel" range="value" type="string" value="mix" widget="menu" description="The channel to return values from.">
		        <menu key="left" label="Left"/>
		        <menu key="right" label="Right"/>
		        <menu key="mix" label="Mix"/>
		    </port>
            <port name="averages" type="int"
                  description="The number of averages to take." value="0"/>
            <port name="context" type="context"
                  description="The internal execution context."/>
        </node>
        <node category="device" description="Logarithmic FFT analysis with Minim" function="device/audioLogAvg"
              image="audio_log_avg.png" name="audio_log_avg" position="1.00,1.00" outputType="float" outputRange="list">
            <port name="device_name" type="string"
                  description="The audio device." value="audio1"/>
        	<port name="channel" label="Channel" range="value" type="string" value="mix" widget="menu" description="The channel to return values from.">
		        <menu key="left" label="Left"/>
		        <menu key="right" label="Right"/>
		        <menu key="mix" label="Mix"/>
		    </port>
            <port name="baseFreq" type="int" description="The minimum frequency to include." value="22"/>
            <port name="bandsPerOctave" type="int" description="The number of bands per octave." value="3"/>
            <port name="context" type="context"
                  description="The internal execution context."/>
        </node>
        <node category="device" description="Audio wave with Minim" function="device/audioWave"
              image="audio_wave.png" name="audio_wave" position="1.00,1.00" outputType="float" outputRange="list">
            <port name="device_name" type="string"
                  description="The audio device." value="audio1"/>
            <port name="context" type="context"
                  description="The internal execution context."/>
        </node>
        <node category="device" description="Beat Detect with Minim" function="device/beatDetect"
              image="beat_detect.png" name="beat_detect" position="1.00,1.00" outputType="data">
            <port name="device_name" type="string"
                  description="The audio device." value="audio1"/>
            <port name="context" type="context"
                  description="The internal execution context."/>
        </node>
        <node category="device" description="Load sound files (mp3, wav, aif, flac, ogg) and extract normalized waveform samples." function="device/soundWaveform" image="audio_wave.png" name="sound_file" outputRange="list" outputType="float" position="1.00,7.00">
            <port name="file" label="Sound File" range="value" type="string" value="" widget="file" description="Path to the sound file (mp3, wav, aif, etc.)."/>
            <port min="1.0" max="10000.0" name="samples" label="Sample Count" range="value" type="int" value="100" widget="int" description="Number of amplitude points to extract."/>
            <port name="channel" label="Channel" range="value" type="string" value="mix" widget="menu" description="Audio channel.">
                <menu key="mix" label="Mix (Mono)"/>
                <menu key="left" label="Left Channel"/>
                <menu key="right" label="Right Channel"/>
            </port>
            <port name="context" type="context" description="The internal execution context."/>
        </node>
        <node category="device" description="Extract audio frequency spectrum band magnitudes from a sound file." function="device/soundSpectrum" image="audio_analysis.png" name="sound_spectrum" outputRange="list" outputType="float" position="3.00,7.00">
            <port name="file" label="Sound File" range="value" type="string" value="" widget="file" description="Path to the sound file (mp3, wav, aif, etc.)."/>
            <port min="2.0" max="256.0" name="bands" label="Frequency Bands" range="value" type="int" value="16" widget="int" description="Number of frequency bands."/>
            <port min="0.1" max="10.0" name="speed" label="Playback Speed" range="value" type="float" value="1.0" widget="float" description="Playback speed multiplier."/>
            <port name="context" type="context" description="The internal execution context."/>
        </node>
        <node category="device" description="Get metadata and volume metrics (duration, sample rate, RMS) for a sound file." function="device/soundInfo" image="beat_detect.png" name="sound_info" outputType="data" position="5.00,7.00">
            <port name="file" label="Sound File" range="value" type="string" value="" widget="file" description="Path to the sound file."/>
        </node>
    </node>
</ndbx>
